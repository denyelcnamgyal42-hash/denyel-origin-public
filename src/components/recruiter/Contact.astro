---
// DENYEL — ORIGIN · Contact (verified channels only; CV gated on real PDF)
import SectionHead from './SectionHead.astro';
import Icon from '../ui/Icon.astro';
import Emph from '../ui/Emph.astro';
import { isVerifiedHref, recruiter as r } from '../../data/story';

const x = r.contact;
const hasEmail = isVerifiedHref(x.email.href) && Boolean(x.email.value);
const socials = x.links.filter((l) => isVerifiedHref(l.href));
const cvs = r.cv.files.filter((f) => isVerifiedHref(f.href) || f.href.endsWith('.pdf'));
const hasChannels = hasEmail || socials.length > 0 || cvs.length > 0;
---

<section id="contact" class="contact" aria-labelledby="contact-title">
  <SectionHead id="contact-title" kicker={x.kicker} title={x.title} aside={x.aside} />

  <div class="memo" data-land>
    <div class="memo__page">
      <p class="memo__hello">{x.hello}</p>
      <p class="memo__open marked"><Emph text={x.open} /></p>
      <p class="memo__where label">{x.where}</p>

      {hasEmail && (
        <div class="memo__mail">
          <a class="go go--main memo__email" href={x.email.href} aria-label={`${x.email.label}: ${x.email.value}`}>
            <Icon name="mail" /><span>{x.email.value}</span>
          </a>
          <button
            type="button"
            class="btn-sticker btn-sticker--mustard memo__copy"
            style="--tilt:-3deg"
            data-copy={x.email.value}
            data-copied={x.email.copied}
            aria-label={x.email.copyLabel}
          >
            <Icon name="copy" /><span>{x.email.copy}</span>
          </button>
        </div>
      )}

      {socials.length > 0 && (
        <ul class="memo__links">
          {socials.map((l) => (
            <li>
              <a
                class="go go--second memo__link"
                href={l.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${l.label}: ${l.value}`}
              >
                <Icon name={l.icon} />
                <span class="memo__label">{l.label}</span>
                <span class="memo__value">{l.value}</span>
                <span class="go__arrow" aria-hidden="true">↗</span>
                <span class="sr-only">{x.newTab}</span>
              </a>
            </li>
          ))}
        </ul>
      )}

      {cvs.length > 0 && (
        <div class="memo__cv">
          <span class="label">{x.cv}</span>
          {cvs.map((f) => (
            <a class="go go--second" href={f.href} download>
              <Icon name="cv" />{f.label}
            </a>
          ))}
        </div>
      )}

      {!hasChannels && <p class="memo__pending">{x.pending}</p>}
      {hasChannels && cvs.length === 0 && <p class="memo__pending">{x.pending}</p>}
    </div>
  </div>

  <footer class="contact__end">
    <a class="btn-tag" href="/" data-bleed="ink"><span aria-hidden="true">←</span> {x.back}</a>
    <p class="contact__sign label">{x.sign}</p>
  </footer>
</section>

<style>
  .contact { position: relative; }

  .memo {
    max-width: 720px;
    margin: 0 auto;
    position: relative;
    width: min(640px, 100%);
    margin: 24px auto 0;
    filter: drop-shadow(0 18px 18px rgba(20, 17, 19, .18));
    transition: translate .7s cubic-bezier(.3, 1.3, .5, 1), opacity .5s;
  }
  :global(.can-land) .memo:not(.is-in) { opacity: 0; translate: 0 50px; }

  .memo__page {
    position: relative;
    padding: 36px 32px 32px;
    background:
      linear-gradient(180deg, rgba(0, 183, 255, .08), transparent 28%),
      #fff;
    border: 1.5px solid rgba(20, 17, 19, .12);
    border-radius: 18px;
  }

  .memo__hello {
    margin: 0;
    font: 500 clamp(34px, 4.5vw, 46px)/1.05 var(--font-title);
    color: #0b1524;
  }
  .memo__open { margin: 14px 0 6px; font: 600 17px/1.55 var(--font-text); }
  .memo__open :global(em) { --marker: rgba(0, 183, 255, .32); }
  .memo__where { margin: 0 0 26px; }

  .memo__mail { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px; margin-bottom: 14px; }
  .memo__email { font-size: 15.5px; }
  .memo__copy { padding: 9px 13px; }
  .memo__copy.is-done { --fill: var(--sage-light); }

  .memo__links { display: grid; gap: 10px; margin: 0 0 22px; padding: 0; list-style: none; }
  .memo__link { width: 100%; }
  .memo__label { min-width: 84px; }
  .memo__value { margin-left: auto; font-weight: 500; color: var(--muted); transition: color .2s; }
  .memo__link:hover .memo__value,
  .memo__link:focus-visible .memo__value { color: inherit; }

  .memo__cv { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 12px; }
  .memo__cv .label { margin-right: 4px; }
  .memo__pending { margin: 8px 0 0; font: 500 14px/1.5 var(--font-text); color: var(--muted); }

  .contact__end { display: grid; justify-items: center; gap: 16px; margin-top: 84px; text-align: center; }
  .contact__sign { margin: 0; text-transform: none; letter-spacing: .04em; font-weight: 500; }

  @media (max-width: 760px) {
    .memo__page { padding: 28px 18px 22px; }
    .memo__open { font-size: 16px; }
    .memo__email { width: 100%; font-size: 14px; padding: 0 12px; }
    .memo__email span { overflow-wrap: anywhere; }
    .memo__link { padding: 0 12px; font-size: 14px; }
    .memo__label { min-width: 0; }
    .memo__cv .label { width: 100%; }
    .contact__end { margin-top: 64px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .memo { transition: none; }
  }
</style>
