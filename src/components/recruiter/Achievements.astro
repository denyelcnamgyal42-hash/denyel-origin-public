---
// DENYEL — ORIGIN · Achievements (competitions / awards — verified only)
import SectionHead from './SectionHead.astro';
import { isVerifiedHref, recruiter as r } from '../../data/story';

const x = r.achievements;
const items = x.items;
if (items.length === 0) return;
---

<section id="achievements" class="ach" aria-labelledby="achievements-title">
  <SectionHead id="achievements-title" kicker={x.kicker} title={x.title} aside={x.aside} />

  <ul class="ach__list">
    {items.map((item) => {
      const hasLink = item.href && isVerifiedHref(item.href);
      const Tag = hasLink ? 'a' : 'div';
      const linkProps = hasLink
        ? { href: item.href, target: '_blank', rel: 'noopener noreferrer' }
        : {};
      return (
        <li class="ach__item" data-land>
          <Tag class="ach__card" {...linkProps}>
            <h3 class="ach__name">{item.title}</h3>
            <p class="ach__context">{item.context}</p>
            {item.when && <p class="ach__when label">{item.when}</p>}
          </Tag>
        </li>
      );
    })}
  </ul>
</section>

<style>
  .ach { position: relative; }

  .ach__list {
    display: grid;
    gap: 16px;
    max-width: 820px;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  .ach__card {
    display: grid;
    gap: 8px;
    padding: 22px 24px;
    background: #0f1a2b;
    color: #f4f7fb;
    border-radius: 14px;
    text-decoration: none;
    border: 1px solid rgba(244, 247, 251, .12);
    transition: border-color .25s, translate .25s;
  }
  a.ach__card:hover,
  a.ach__card:focus-visible {
    border-color: rgba(0, 183, 255, .5);
    translate: 4px 0;
  }

  .ach__name { margin: 0; font: 500 24px/1.15 var(--font-title); }
  .ach__context { margin: 0; font: 500 15px/1.5 var(--font-text); color: rgba(244, 247, 251, .72); }
  .ach__when { margin: 4px 0 0; color: rgba(125, 220, 255, .85); }

</style>
