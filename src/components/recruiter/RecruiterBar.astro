---
// VOL.01 · Ines Cherif · github.com/inesCherif/vol01-manga-portfolio · MIT (code only; art, story and CV are all rights reserved, see LICENSE-ASSETS)
// The recruiter page's top bar. Desktop: back to the story, the sections split around her handwritten
// name, LinkedIn + GitHub + the CV. Phones: back, the name, and a menu that drops a torn paper sheet.
// A scribbled underline follows the section being read (scripts/recruiter/bar.ts).
import Icon from '../ui/Icon.astro';
import { isVerifiedHref, person, recruiter as r } from '../../data/story';

const sections = r.sections.filter((s) => {
  if (s.id === 'training') return r.training.items.length > 0;
  if (s.id === 'achievements') return r.achievements.items.length > 0;
  if (s.id === 'leadership') return (r.leadership?.features?.length ?? r.leadership?.items?.length ?? 0) > 0;
  if (s.id === 'community') return (r.community.groups?.length ?? 0) > 0;
  return true;
});
const half = Math.ceil(sections.length / 2) - 1;
const left = sections.slice(0, half);
const right = sections.slice(half);
const linkedin = isVerifiedHref(person.links.linkedin) ? person.links.linkedin : '';
const github = isVerifiedHref(person.links.github) ? person.links.github : '';
const cvs = r.cv.files.filter((f) => isVerifiedHref(f.href) || f.href.endsWith('.pdf'));
---

<header class="rbar" data-bar>
  <a class="rbar__back btn-tag" href="/" data-bleed="ink" aria-label={r.backLabel}>
    <span aria-hidden="true">←</span> {r.back}
  </a>

  <nav class="rbar__nav" aria-label="Sections">
    {left.map((s) => <a href={`#${s.id}`} data-nav={s.id}>{s.label}</a>)}
    <a class="rbar__logo hand" href="#about" aria-label={`${person.name}, top of the page`}>{r.logo}</a>
    {right.map((s) => <a href={`#${s.id}`} data-nav={s.id}>{s.label}</a>)}
    <svg class="rbar__scribble" viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true" data-scribble>
      <path d="M2 5.5C14 2 22 7 34 4.2S58 2.6 70 4.8 90 3 98 4.4" />
    </svg>
  </nav>
  <a class="rbar__logo rbar__logo--phone hand" href="#about" aria-label={`${person.name}, top of the page`}>{r.logo}</a>

  <div class="rbar__out">
    {linkedin && <a href={linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn profile for Denyel"><Icon name="linkedin" /></a>}
    {github && <a href={github} target="_blank" rel="noopener noreferrer" aria-label="GitHub profile for Denyel"><Icon name="github" /></a>}
    {cvs.length > 0 && (
      <details class="rbar__cv">
        <summary class="btn-sticker btn-sticker--mustard"><Icon name="cv" />{r.cv.label}</summary>
        <div class="rbar__files">
          {cvs.map((f) => <a href={f.href} target="_blank" rel="noopener"><Icon name="cv" /> {f.label}</a>)}
        </div>
      </details>
    )}
  </div>

  <button class="rbar__menu btn-tag" type="button" aria-expanded="false" aria-controls="rbar-sheet" data-menu>
    <span class="rbar__burger" aria-hidden="true"><i></i><i></i></span>{r.menu}
  </button>
  <div class="rbar__sheet" id="rbar-sheet" hidden data-sheet>
    <nav aria-label="Sections">
      {sections.map((s, i) => <a href={`#${s.id}`} style={`--i:${i}`}>{s.label}</a>)}
    </nav>
    <div class="rbar__sheet-out">
      {linkedin && <a class="btn-sticker btn-sticker--peri" style="--tilt:-2deg" href={linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn profile for Denyel"><Icon name="linkedin" /> LinkedIn</a>}
      {github && <a class="btn-sticker btn-sticker--lilac" style="--tilt:1.5deg" href={github} target="_blank" rel="noopener noreferrer" aria-label="GitHub profile for Denyel"><Icon name="github" /> GitHub</a>}
      {cvs.map((f, i) => <a class="btn-sticker btn-sticker--mustard" style={`--tilt:${i ? 2 : -1}deg`} href={f.href} target="_blank" rel="noopener"><Icon name="cv" /> {r.cv.label} · {f.label}</a>)}
    </div>
  </div>
</header>

<style>
  .rbar {
    position: sticky; top: 0; z-index: 60;
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
    height: var(--bar-h); padding: 0 var(--edge);
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: blur(6px);
    border-bottom: 1.5px solid rgba(20, 17, 19, .12);
  }
  .rbar__nav a, .rbar__logo, .rbar__out > a, .rbar__files a, .rbar__sheet nav a { color: var(--ink); text-decoration: none; }

  .rbar__back { justify-self: start; }

  .rbar__nav { position: relative; display: flex; align-items: center; gap: clamp(14px, 2vw, 28px); font: 500 15px/1 var(--font-text); }
  .rbar__nav a[data-nav] { padding: 8px 0; color: var(--muted); transition: color .2s; }
  .rbar__nav a[data-nav]:hover, .rbar__nav a[data-nav].is-on { color: var(--ink); }
  .rbar__logo { font-size: 38px; line-height: 1; margin: 0 clamp(6px, 1vw, 14px); transition: rotate .25s; }
  .rbar__logo:hover { rotate: -4deg; }
  .rbar__logo--phone { display: none; }
  /* the hand-drawn underline that slides to the section being read */
  .rbar__scribble {
    position: absolute; left: 0; bottom: -4px; height: 8px; width: 0;
    fill: none; stroke: var(--rose-deep); stroke-width: 2.2; stroke-linecap: round; overflow: visible;
    transition: translate .45s cubic-bezier(.3, 1.4, .5, 1), width .45s cubic-bezier(.3, 1.4, .5, 1), opacity .2s;
  }

  .rbar__out { justify-self: end; display: flex; align-items: center; gap: 14px; }
  .rbar__out > a { display: grid; place-items: center; transition: rotate .2s, color .2s; }
  .rbar__out > a:hover { color: var(--rose-deep); rotate: -10deg; }
  .rbar__cv { position: relative; }
  .rbar__cv summary { list-style: none; }
  .rbar__cv summary::-webkit-details-marker { display: none; }
  .rbar__files {
    position: absolute; right: 0; top: calc(100% + 10px);
    display: grid; gap: 4px; padding: 10px; min-width: 150px;
    background: var(--card); border: 1.5px solid var(--line); border-radius: 12px;
    box-shadow: 0 12px 24px -12px rgba(20, 17, 19, .4); rotate: 1.5deg;
  }
  .rbar__files a { display: flex; align-items: center; gap: 8px; padding: 8px; border-radius: 8px; font: 600 14px/1 var(--font-text); }
  .rbar__files a:hover { background: var(--rose-wash); }

  .rbar__menu, .rbar__sheet { display: none; }

  @media (max-width: 1080px) {
    .rbar { grid-template-columns: 1fr auto 1fr; }
    .rbar__nav, .rbar__out { display: none; }
    .rbar__logo--phone { display: block; margin: 0; }
    .rbar__menu { justify-self: end; display: inline-flex; rotate: 2deg; }
    .rbar__burger { display: grid; gap: 4px; width: 16px; }
    .rbar__burger i { height: 1.5px; background: currentColor; transition: rotate .25s, translate .25s; }
    .rbar__menu[aria-expanded='true'] .rbar__burger i:first-child { translate: 0 2.75px; rotate: 45deg; }
    .rbar__menu[aria-expanded='true'] .rbar__burger i:last-child { translate: 0 -2.75px; rotate: -45deg; }

    /* the menu: a torn sheet of paper dropping from the bar */
    .rbar__sheet:not([hidden]) {
      display: grid; gap: 22px;
      position: absolute; left: 12px; right: 12px; top: calc(100% + 6px);
      padding: 26px 24px 30px;
      background: var(--card);
      box-shadow: 0 24px 40px -18px rgba(20, 17, 19, .45);
      clip-path: polygon(0 0, 100% 0, 100% 96%, 94% 99%, 87% 96.5%, 79% 99.5%, 71% 97%, 62% 99%, 53% 96.4%, 45% 99.4%, 36% 97%, 27% 99.2%, 18% 96.6%, 9% 99%, 0 97%);
      animation: sheet-drop .35s cubic-bezier(.3, 1.3, .5, 1);
      transform-origin: top;
    }
    .rbar__sheet nav { display: grid; gap: 4px; }
    .rbar__sheet nav a {
      font: 400 30px/1.15 var(--font-title); padding: 6px 0;
      animation: sheet-item .4s cubic-bezier(.3, 1.3, .5, 1) both; animation-delay: calc(var(--i) * 35ms);
    }
    .rbar__sheet-out { display: flex; flex-wrap: wrap; gap: 10px; padding-top: 18px; border-top: 1.5px dashed rgba(20, 17, 19, .2); }
    .rbar__sheet-out { gap: 14px 12px; }
  }
  @keyframes sheet-drop { from { transform: scaleY(.6); opacity: 0; } }
  @keyframes sheet-item { from { opacity: 0; translate: 0 8px; } }
</style>
