---
// DENYEL — ORIGIN · Education (text-first; certifications live in Training.astro)
import { Image } from 'astro:assets';
import SectionHead from './SectionHead.astro';
import Emph from '../ui/Emph.astro';
import { recruiter as r } from '../../data/story';
import gcit from '../../assets/logos/gcit.png';

const x = r.education;
const logos: Record<string, ImageMetadata> = { gcit };
---

<section id="education" class="edu" aria-labelledby="education-title">
  <SectionHead id="education-title" kicker={x.kicker} title={x.title} aside={x.aside} />

  <ol class="schools">
    {x.schools.map((s) => (
      <li id={`school-${s.id}`} class="school" data-land>
        <article class="school__card" aria-labelledby={`degree-${s.id}`}>
          <header class="school__head">
            {logos[s.id] && <Image src={logos[s.id]} alt="" height={64} class="school__logo" />}
            <div>
              <p class="label">{s.short}</p>
              <h3 id={`degree-${s.id}`} class="school__title">{s.degree}</h3>
              {s.track && <p class="school__track">{s.track}</p>}
            </div>
          </header>

          <p class="school__line">{s.school}<br />{s.when} · {s.where}</p>
          <ul class="school__points marked">
            {s.points.map((pt) => (
              <li><Emph text={pt} /></li>
            ))}
          </ul>
          {s.link && (
            <a class="go go--second school__go" href={s.link.href}>
              {s.link.label}<span class="go__arrow" aria-hidden="true">↑</span>
            </a>
          )}
        </article>
      </li>
    ))}
  </ol>

  <p class="before"><span class="label">{x.before.label}</span> {x.before.text}</p>
</section>

<style>
  .edu { position: relative; }

  .schools {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
    max-width: 820px;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  .school__card {
    padding: 28px 26px;
    background: var(--card);
    border: 1.5px solid rgba(20, 17, 19, .12);
    border-radius: 18px;
    box-shadow: 0 16px 28px -24px rgba(20, 17, 19, .45);
    transition: translate .7s cubic-bezier(.3, 1.3, .5, 1), opacity .5s;
  }
  :global(.can-land) .school:not(.is-in) .school__card { opacity: 0; translate: 0 40px; }

  .school__head {
    display: flex;
    gap: 16px;
    align-items: center;
    margin-bottom: 16px;
  }
  .school__logo {
    width: 56px;
    height: auto;
    border-radius: 10px;
    background: #fff;
  }
  .school__title { margin: 4px 0 0; font: 500 clamp(26px, 2.6vw, 32px)/1.1 var(--font-title); }
  .school__track {
    margin: 8px 0 0;
    display: inline-block;
    padding: 4px 8px;
    border-radius: 6px;
    background: rgba(0, 183, 255, .14);
    font: 700 13px/1.2 var(--font-text);
  }
  .school__line { margin: 0 0 16px; font: 600 14.5px/1.5 var(--font-text); color: var(--muted); }
  .school__points {
    display: grid;
    gap: 10px;
    margin: 0 0 20px;
    padding: 0 0 0 18px;
    font: 500 15px/1.55 var(--font-text);
  }
  .school__points li::marker { color: var(--rose-deep); }
  .school__points :global(em) { --marker: rgba(0, 183, 255, .32); }
  .school__go { width: fit-content; }

  .before {
    max-width: 820px;
    margin: 28px auto 0;
    font: 600 14.5px/1.5 var(--font-text);
    color: var(--muted);
  }
  .before .label { margin-right: 8px; color: var(--ink); }

  @media (max-width: 760px) {
    .school__card { padding: 22px 18px; }
  }
</style>
