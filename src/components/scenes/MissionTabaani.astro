---
// VOL.01 · Ines Cherif · github.com/inesCherif/vol01-manga-portfolio · MIT (code only; art, story and CV are all rights reserved, see LICENSE-ASSETS)
// Chapter 3 opens on the mission board, then Mission 01: the file splits open on the Tabaani
// door, the legacy monster is untangled (HOLD) into modules, and the camera pulls back to the
// board to stamp the file complete. Timeline: scripts/scenes/tabaani.ts.
import { Image } from 'astro:assets';
import Caption from '../ui/Caption.astro';
import ChapterHead from '../ui/ChapterHead.astro';
import HoldButton from '../ui/HoldButton.astro';
import InkBackground from '../ui/InkBackground.astro';
import InkDrips from '../ui/InkDrips.astro';
import MissionBoard from '../ui/MissionBoard.astro';
import { missions, tabaani } from '../../data/story';

import fileOpen from '../../assets/frames/ch3-missions/file-open.jpg';
import door from '../../assets/frames/ch3-mission/door.jpg';
import monster from '../../assets/frames/ch3-mission/monster.jpg';
import faceoff from '../../assets/frames/ch3-mission/faceoff.jpg';
import modules from '../../assets/frames/ch3-mission/modules.jpg';

const c = tabaani.captions;
---

<div data-scene="tabaani">
  <InkDrips />

  <section class="scene tabaani" id="missions" aria-label="Chapter 3: Missions. Mission 01, Jaggle.ai">
    <InkBackground fixed />
    <MissionBoard />
    <div class="scene__pin">
      <div class="tabaani__stage" data-part="stage">
        <div class="tabaani__inside" data-part="inside">
          <div class="panel tabaani__frame" data-part="door" data-depth="-10">
            <div class="panel__cam" data-part="door-cam">
              <Image src={door} alt="Opening the Jaggle.ai internship door — manga panel" widths={[960, 990]} sizes="90vw" loading="lazy" />
            </div>
          </div>
          <Image class="tabaani__creature ink-layer" data-part="monster" data-depth="30" src={monster} alt="Manga metaphor: tangled product systems as a challenge" widths={[960, 1408]} sizes="80vw" loading="lazy" />
          <div class="panel tabaani__frame tabaani__faceoff" data-part="faceoff" data-depth="-12">
            <Image src={faceoff} alt="Facing the internship challenge — manga panel" widths={[960, 1350]} sizes="90vw" loading="lazy" />
          </div>
          <Image class="tabaani__creature ink-layer" data-part="modules" data-depth="24" src={modules} alt="Modular work logged at Jaggle.ai — manga panel" widths={[960, 1408]} sizes="80vw" loading="lazy" />
          <p class="tabaani__sfx" data-part="sfx" data-depth="44" aria-hidden="true">{tabaani.sfx}</p>
          <div class="overlay speed" data-part="speed" aria-hidden="true"></div>
        </div>

        <!-- the dossier, split along its broken seal: two halves that tear apart on the door -->
        <div class="tabaani__file" data-part="file" aria-hidden="true">
          <Image class="tabaani__flap tabaani__flap--top" data-part="flap" src={fileOpen} alt="" widths={[960, 1408]} sizes="100vw" loading="lazy" />
          <Image class="tabaani__flap tabaani__flap--bottom" data-part="flap" src={fileOpen} alt="" widths={[960, 1408]} sizes="100vw" loading="lazy" />
        </div>

        <Caption text={missions.board} class="tabaani__cap tabaani__cap--board caption--dark" data-caption="board" />
        <Caption text={c.door} class="tabaani__cap tabaani__cap--story" data-caption="door" />
        <Caption text={c.legacy} class="tabaani__cap tabaani__cap--legacy" data-caption="legacy" />
        <Caption text={c.untangle} class="tabaani__cap tabaani__cap--story" data-caption="untangle" />
        <Caption text={c.modules} class="tabaani__cap tabaani__cap--modules" data-caption="modules" />
        <Caption text={c.hosts} class="tabaani__cap tabaani__cap--modules" data-caption="hosts" />
        <Caption text={c.next} class="tabaani__cap tabaani__cap--board caption--dark" data-caption="next" />

        <HoldButton name="untangle" label="Hold to<br/>untangle" hint="Hold to turn the product tangle into shippable pieces" class="tabaani__hold" />
      </div>

      <ChapterHead label={missions.label} title={missions.title} sub={missions.sub} />
    </div>
  </section>
</div>

<style>
  .tabaani { z-index: 2; clip-path: inset(0); }
  .tabaani__stage { position: absolute; inset: 0; color: var(--ink); }
  .tabaani__inside {
    position: absolute; inset: 0; background: var(--paper); will-change: transform;
    /* off screen while full size; when the mission folds back into its file it reads as a framed page */
    box-shadow: 0 0 0 18px var(--paper), 0 0 0 26px var(--ink);
  }

  .tabaani__frame { left: 7vw; right: 7vw; top: 13vh; bottom: 7vh; }
  .tabaani__faceoff { z-index: 3; }

  .tabaani :global(.tabaani__creature) {
    /* centred without transforms: GSAP owns the transform (timeline + mouse parallax) */
    --w: min(80vw, 140vh); --cy: 53%;
    position: absolute; z-index: 2;
    width: var(--w); max-width: none; height: calc(var(--w) * 768 / 1408);
    left: calc(50% - var(--w) / 2); top: calc(var(--cy) - var(--w) * 384 / 1408);
    /* lift the drawing's paper to white so multiply drops it, and melt the edges */
    filter: brightness(1.08) contrast(1.15);
    -webkit-mask: radial-gradient(ellipse 50% 50% at 50% 50%, #000 70%, transparent 100%);
            mask: radial-gradient(ellipse 50% 50% at 50% 50%, #000 70%, transparent 100%);
  }
  .tabaani__sfx {
    position: absolute; right: 10vw; top: 13vh; z-index: 5; margin: 0;
    font: 400 clamp(90px, 13vw, 210px)/1 var(--font-title);
    color: var(--rose); -webkit-text-stroke: 3px var(--ink); paint-order: stroke fill;
  }

  .tabaani__file { position: absolute; inset: 0; z-index: 7; will-change: transform; }
  .tabaani :global(.tabaani__flap) { position: absolute; inset: 0; width: 100%; height: 100%; max-width: none; object-fit: cover; }
  .tabaani :global(.tabaani__flap--top) { clip-path: inset(0 0 50% 0); }
  .tabaani :global(.tabaani__flap--bottom) { clip-path: inset(50% 0 0 0); }

  /* caption positions on large screens; phones use the shared rule in comic.css */
  @media (min-width: 761px) {
    .tabaani :global(.tabaani__cap--board) { left: 50%; bottom: 6vh; translate: -50% 0; }
    .tabaani :global(.tabaani__cap--story) { left: 9vw; bottom: 10vh; }
    .tabaani :global(.tabaani__cap--legacy) { left: 7vw; top: 18vh; }
    .tabaani :global(.tabaani__cap--modules) { left: 50%; bottom: 7vh; translate: -50% 0; }
  }
  .tabaani :global(.tabaani__hold) { right: 13vw; top: 38vh; }

  @media (max-width: 760px) {
    .tabaani__frame { left: 16px; right: 16px; top: 20vh; bottom: auto; height: 44vh; }
    .tabaani__frame :global(img) { object-position: 64% 50%; }
    .tabaani :global(.tabaani__creature) { --w: 150vw; --cy: 42%; }
    .tabaani__sfx { right: 16px; top: 15vh; font-size: 96px; }
    .tabaani :global(.tabaani__hold) { right: 24px; top: 66vh; }
  }
</style>
