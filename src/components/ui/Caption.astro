// A narration box. Words wrapped in *stars* are drawn in the accent colour.
import Emph from './Emph.astro';

interface Props {
  text: string;
  class?: string;
  [attr: string]: unknown;
}
const { text, class: className, ...attrs } = Astro.props;
---

<p class:list={['caption', className]} {...attrs}><Emph text={text} /></p>
