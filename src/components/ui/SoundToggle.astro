---
<button class="sound" data-sound aria-label="Toggle sound" aria-pressed="false">
  <span></span><span></span><span></span><span></span>
</button>

<style>
  /* four little bars like an equaliser */
  .sound {
    position: fixed; right: var(--edge); bottom: 24px; z-index: 60;
    display: flex; align-items: flex-end; gap: 3px; height: 26px; width: 44px; padding: 0 8px;
    background: none; border: 0; mix-blend-mode: difference;
  }
  span { width: 3px; height: 6px; background: var(--paper); border-radius: 2px; transition: height .3s; }
  .sound[aria-pressed='true'] span { animation: eq 1s ease-in-out infinite; }
  span:nth-child(2) { animation-delay: -.3s !important; }
  span:nth-child(3) { animation-delay: -.6s !important; }
  span:nth-child(4) { animation-delay: -.15s !important; }
  @keyframes eq { 0%, 100% { height: 6px; } 50% { height: 22px; } }
</style>
