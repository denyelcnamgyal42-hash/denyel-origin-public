---
// DENYEL — ORIGIN · top bar
import { person } from '../../data/story';
const first = person.shortName ?? person.name.split(' ')[0] ?? person.name;
const last = person.tagline || 'ORIGIN';
---

<header class="bar">
  <a class="bar__logo" href="#top">
    <span class="bar__mono">D</span>
    <span class="bar__name">{first}<br /> {last}</span><span class="sr-only">, back to top</span>
  </a>
  <nav class="bar__nav" aria-label="Main">
    <a href="#story" class="is-active">Story</a>
    <span class="bar__sep" aria-hidden="true">✦</span>
    <a href="/recruiter/" data-bleed="colour">Recruiter mode</a>
  </nav>
</header>

<style>
  .bar {
    position: fixed; top: 0; left: 0; right: 0; z-index: 60;
    display: flex; justify-content: space-between; align-items: center;
    padding: 18px var(--edge);
    pointer-events: none; mix-blend-mode: difference; color: var(--paper);
  }
  .bar > * { pointer-events: auto; }
  .bar__logo { display: flex; align-items: center; gap: 10px; color: inherit; text-decoration: none; }
  .bar__mono {
    font-family: var(--font-title); font-size: 22px;
    width: 46px; height: 46px; border: 1.5px solid currentColor; border-radius: 50%;
    display: grid; place-items: center;
  }
  .bar__name { font-family: var(--font-title); font-size: 17px; line-height: .95; }
  .bar__nav {
    display: flex; align-items: center; gap: 16px;
    border: 1.5px solid currentColor; padding: 12px 20px;
    font: 800 13px/1 var(--font-text); letter-spacing: .06em; text-transform: uppercase;
  }
  .bar__nav a { color: inherit; text-decoration: none; opacity: .6; }
  .bar__nav a.is-active, .bar__nav a:hover { opacity: 1; }
  .bar__sep { font-size: 11px; }

  @media (max-width: 760px) {
    .bar__nav { padding: 10px 12px; gap: 10px; font-size: 11px; }
    .bar__name { display: none; }
  }
</style>
